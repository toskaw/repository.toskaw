<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.toskaw" name="My Custom Repository" version="1.0.0" provider-name="toskaw">
    <extension point="xbmc.addon.repository" name="Kodi addon repository by toskaw">
        <dir>
            <!-- 1. 目録（addons.xml）を配置するWebサーバーのURL -->
            <info compressed="false">https://raw.githubusercontent.com/toskaw/repository.toskaw/main/addons.xml</info>
            <!-- 2. アドオンのZIP群を配置するWebサーバーのURL -->
            <checksum>https://raw.githubusercontent.com/toskaw/repository.toskaw/main/addons.xml.md5</checksum>
            <!-- 3. チェックサム（addons.xml.md5）を配置するWebサーバーのURL -->
            <datadir zip="true">https://raw.githubusercontent.com/toskaw/repository.toskaw/main/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>My personal Kodi addon repository</summary>
        <description>This repository contains my custom video and script addons for Kodi.</description>
        <platform>all</platform>
    </extension>
</addon>
